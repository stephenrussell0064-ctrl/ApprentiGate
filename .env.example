# Copy to .env.local for local development. .env.local is git-ignored.
#
# NOTHING SECRET BELONGS IN THIS FILE OR IN .env.local.
# The two secrets this project uses are loaded by the operator with
# `wrangler secret put` and are never written to the repository.
# See README "Environment" for the full table.

# ---------------------------------------------------------------------------
# Public, build-time. Inlined into the exported HTML by Next.
# ---------------------------------------------------------------------------

# Absolute origin the site is served from. Drives every canonical tag, sitemap
# entry, OG/Twitter URL, JSON-LD url property and llms.txt reference.
# Local: leave unset (defaults to http://localhost:3000).
# Preview: the *.workers.dev URL Cloudflare assigns.
# Production: https://apprentigate.com — set at cutover (WP16), not before.
#   The domain is owned, but DNS, mail routing and Resend verification are not
#   yet in place, and the site must not be publicly reachable on it until it has
#   passed Stage 5 verification.
NEXT_PUBLIC_SITE_URL=

# "true" allows search engines to index the site. ANY other value disallows it.
# Must stay unset/false on the preview deployment: an indexed preview URL creates
# duplicate content against the real domain. Flipped to true at cutover (WP16).
NEXT_PUBLIC_ALLOW_INDEXING=

# Business VoIP number. Leave unset until the operator provisions one; the site
# then shows a non-dialable notice instead. Never commit a personal mobile.
NEXT_PUBLIC_BUSINESS_PHONE=

# Companies House number. Leave unset until incorporation — the site must not
# show a company number, "Ltd", or a registered office before then.
NEXT_PUBLIC_COMPANY_NUMBER=

# Enquiries mailbox, e.g. enquiries@<your domain>. Leave unset until the
# operator has created it — the footer omits the row rather than showing an
# address that bounces.
NEXT_PUBLIC_ENQUIRIES_EMAIL=

# Cal.com link slug, e.g. apprentigate/consultation. Leave unset until the
# operator has created the account and event type.
NEXT_PUBLIC_CAL_LINK=

# Cloudflare Turnstile site key. Public by design; the secret half is loaded
# with `wrangler secret put TURNSTILE_SECRET_KEY`. While unset, the enquiry form
# declines submissions rather than accepting unverified ones.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics token. Cookieless and aggregate, so no consent
# banner is needed — but it is a third-party script, and the cookie policy
# names it automatically whenever this is set.
NEXT_PUBLIC_ANALYTICS_TOKEN=
