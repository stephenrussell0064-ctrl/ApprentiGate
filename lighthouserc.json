{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "_comment": "Deliberately non-indexable pages: the two not-found variants and the internal component gallery. Lighthouse scores noindex as an SEO failure, so asserting the SEO category here would amount to requiring that these pages be indexable, which is the opposite of what they are for. Every other category still applies.",
          "matchingUrlPattern": ".*/(404|_not-found|components)\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/(404|_not-found|components)\\.html$).*$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
