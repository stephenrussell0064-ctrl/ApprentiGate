{
  "name": "apprentigate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "wrangler dev",
    "deploy": "pnpm guard:indexing && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "guard:domains": "node scripts/check-hardcoded-domains.mjs",
    "guard:tokens": "node scripts/check-design-tokens.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "serve:out": "serve out --listen 4321 --no-clipboard",
    "lighthouse": "pnpm build:audit && lhci autorun",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm guard:domains && pnpm guard:tokens && pnpm test:unit && pnpm test:browser",
    "build:audit": "NEXT_PUBLIC_ALLOW_INDEXING=true next build",
    "guard:indexing": "node scripts/check-build-indexing.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "qa:report": "node scripts/qa-report.mjs",
    "claim:audit": "node scripts/claim-audit.mjs"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
