{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apprentigate",
  "compatibility_date": "2026-08-24",

  // Workers Static Assets, not Pages. Cloudflare's current guidance is that new
  // projects should start on Workers; Pages remains supported but all new
  // investment is going to Workers. See README "Deployment target".
  "main": "worker/index.ts",

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",

    // Serves out/404.html for unmatched paths, which is the custom 404 page.
    "not_found_handling": "404-page",

    // Pairs with `trailingSlash: false` in next.config.ts. Changing one without
    // the other causes redirect loops.
    "html_handling": "auto-trailing-slash",

    // The Worker runs for this one path and nothing else. Every other request
    // is served straight from static assets without invoking it at all.
    "run_worker_first": ["/api/enquiry"],
  },

  // Slows a scripted flood of the enquiry endpoint. Per Cloudflare location and
  // eventually consistent, which is the right shape for this: it is a brake on
  // abuse, not an accounting system, and it is not the only defence — the
  // honeypot and Turnstile sit behind it.
  "ratelimits": [
    {
      "name": "ENQUIRY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        // Must be 10 or 60.
        "period": 60,
      },
    },
  ],

  "observability": {
    "enabled": true,
  },

  // The production hostname. `custom_domain` makes Cloudflare manage the DNS
  // record for it, replacing whatever the apex pointed at before. Only the apex
  // is attached: serving the same content on www as well is the same
  // duplicate-content problem described for workers_dev below, so www is a
  // redirect to the apex rather than a second origin.
  //
  // Routes are applied by `wrangler deploy`, not by `wrangler versions deploy`.
  "routes": [{ "pattern": "apprentigate.com", "custom_domain": true }],

  // The preview origin, deliberately left on while the site is pre-cutover:
  // apprentigate.stephen-russell0064.workers.dev is where the build is checked
  // before it is put in front of anyone. The build served there is noindex and
  // its robots.txt disallows everything, so it cannot compete with the real
  // domain for indexing.
  //
  // AT CUTOVER, set this to false. Leaving it true once the custom domain is
  // attached gives the site a second reachable origin serving identical
  // content, which is a duplicate-content problem and a second surface to
  // secure for no benefit.
  "workers_dev": false,

  // Per-version preview URLs, same reasoning and the same instruction at
  // cutover.
  "preview_urls": false,

  // Non-secret Worker configuration. The mailbox addresses are set here at
  // cutover rather than committed, because they live on the production domain
  // and no domain may be hardcoded.
  //
  // Secrets — RESEND_API_KEY and TURNSTILE_SECRET_KEY — are loaded by the
  // operator with `wrangler secret put` and never appear in this file.
  // See README "Environment".
  "vars": {},
}
